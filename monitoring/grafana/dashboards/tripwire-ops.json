        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Detectors behind simulator",
      "description": "Simulated time between the simulator's latest event and the detectors'. A fresh heartbeat only proves a loop runs; this proves events get through.",
